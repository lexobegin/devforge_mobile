# ============================================================
# DevForge AI Mobile — Variables de entorno
# ============================================================
# Copiar a .env y ajustar según entorno.
# Este archivo se carga al arrancar la app con flutter_dotenv
# (o similar). Si no usamos dotenv todavía, se pueden pasar con
# --dart-define al compilar.
# ============================================================

# --- Backend API (REST) ---
# URL base del backend de la plataforma DevForge AI
API_BASE_URL=http://10.0.2.2:8000/api/v1
# Nota: 10.0.2.2 es el alias del host local para emulador Android.
# Para dispositivo físico, usar la IP de la máquina de desarrollo
# (ej: http://192.168.1.100:8000/api/v1).

# --- Backend WebSocket (colaboración) ---
WS_BASE_URL=ws://10.0.2.2:8000

# --- Modo de operación ---
APP_ENV=development

# --- Feature flags ---
ENABLE_OFFLINE=true
ENABLE_AI_LOCAL=true
ENABLE_AI_CLOUD_FALLBACK=true

# --- Timeouts ---
API_TIMEOUT_MS=30000
WS_RECONNECT_MAX_ATTEMPTS=10
WS_RECONNECT_INITIAL_DELAY_MS=1000

# --- Versionado ---
APP_VERSION=0.1.0